# ===========================================
# LOCAL REVIEW RESPONDER - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# In Vercel, set these for Production and Preview (redeploy after changes).

# Database (Neon PostgreSQL) — pooled and direct connection strings
DATABASE_URL="postgresql://username:password@hostname/database?sslmode=require"
DIRECT_URL="postgresql://username:password@hostname/database?sslmode=require"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Google OAuth
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Comma-separated emails allowed to sign in (unset/empty = nobody can sign in)
ALLOWED_EMAILS=

# Bearer token for /api/cron/sync-reviews and /api/test-email (unset = both reject every request)
CRON_SECRET="generate-a-random-secret-here"

# Gmail SMTP for review alerts (use a Google App Password, not the account password)
GMAIL_USER="admin@localreviewresponder.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# OpenAI (AI review responses)
OPENAI_API_KEY="sk-..."

# Optional: origin shown in the widget embed snippet (defaults to https://app.localreviewresponder.com)
# NEXT_PUBLIC_APP_ORIGIN="https://app.localreviewresponder.com"
